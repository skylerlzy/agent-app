# LLM（与 OpenAI 兼容的网关，如通义千问 DashScope）
DASHSCOPE_API_KEY=sk-67a466c8093e4681aab5653a3853e364
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 外部工具（至少配置两项以上用于出行+日程场景）
AMAP_WEBSERVICE_KEY=
OPEN_WEATHER_MAP_API_KEY=

# 可选：自建日历冲突检测 HTTP 服务（成员实现 mock 或对接学校日历）
CALENDAR_ADAPTER_URL=

# Convex（本地开发见 README）
CONVEX_DEPLOYMENT=

# Reflexion：设为 true 时用 LLM 生成反思（需 DASHSCOPE_API_KEY；成员2 实现 OpenAICompatibleClient 后生效）
USE_LLM_REFLEXION=

# 成员4 联调：weather 工具注入失败（retry_success | skip | abort），用于演示重试/跳过/终止
AGENT_REFLEXION_DEMO=
