# 复制为 .env.local 后填写真实值。勿提交 .env.local。
# 注意：不要把占位词 REPLACE 当作真实部署名，否则 Convex 会报 InvalidDeploymentName。

# ---------- Clerk ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_你的Clerk公钥
CLERK_SECRET_KEY=sk_test_你的Clerk私钥
# 关闭发往 clerk-telemetry.com 的遥测，避免本地开发 CORS / net::ERR_FAILED 控制台噪音（与 ClerkProvider telemetry={false} 二选一即可，建议都开）
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------- Convex 日志（可选）----------
# 单次 action 约 256 行日志上限；默认勿开。需在 Convex Dashboard 为本部署设置同名变量。
# AGENT_VERBOSE_LOGS=1  # 开启后 lib/agent 内 HTTP/LLM 调试日志才会输出（排障后再关）

# ---------- Convex ----------
# 【重要】convex/auth.config.js 使用了 CUSTOM_DOMAIN。第一次 npx convex dev 推送前，
# 请先在下面填好 Clerk 的 Issuer，或在 Convex Dashboard 手动添加同名变量，否则会报错退出。
# Issuer 位置：Clerk Dashboard → Configure → API Keys → 「Frontend API URL / Issuer」
CUSTOM_DOMAIN=https://你的实例.clerk.accounts.dev

# 下面两行由 npx convex dev 在绑定项目后自动写入 .env.local，首次可为空：
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# 修改 NEXT_PUBLIC_CONVEX_URL 后须重新 build / dev（Next 在 build 时内联该变量）。
# 若 /api/eval/run 报「Could not find public function agent:runAgentEval」：
#   说明浏览器/Next 使用的 NEXT_PUBLIC_CONVEX_URL 指向的那套 Convex 部署里，还没有推送过含 runAgentEval 的代码。
#   处理：在 agent-app 目录对「该 URL 所属项目」执行 npx convex dev（开发机常驻）或 npx convex deploy / deploy --prod；
#   改 URL 后务必重启 npm run dev。Dashboard → 该部署 → Functions 中应能看到 agent.runAgentEval。
#
# 本地联调评测：先 `npm run dev`（默认 :3000），Java 评测后端默认 POST http://localhost:3000/api/eval/run。
# 生产用 `npm run start` 时见 package.json 与 scripts/run-standalone.cjs（standalone + 绑定 0.0.0.0）。

# ---------- 通义千问 / DashScope（与 travel-planner-ai 一致；Convex action 内调用，须在 Dashboard 同步）----------
DASHSCOPE_API_KEY=
# 一般为兼容模式 v1，与示例项目默认一致；若阿里云文档有变再改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名，与示例 lib/qwen 默认一致；可按控制台可用列表调整（如 qwen-turbo、qwen-max）
QWEN_MODEL=qwen-plus

# ---------- 工具 API（Convex 控制台配置）----------
# 高德：须为开放平台「应用管理 → 添加 Key → 服务平台选 Web服务」生成的 Key；选错平台会出现 USERKEY_PLAT_NOMATCH
AMAP_WEBSERVICE_KEY=
# 和风天气：控制台「项目管理 → 凭据 → API KEY」；身份认证见 https://dev.qweather.com/docs/configuration/authentication/
QWEATHER_API_KEY=
# QWEATHER_API_HOST（强烈建议配置）：
#   原因：和风为每个账号分配独立 API 域名，与 API KEY 组合使用更安全；公共域名 devapi.qweather.com 等将逐步停用。
#   配置：登录 https://console.qweather.com → 左侧「设置」→ 复制「API Host」（形如 abc1234xyz.def.qweatherapi.com）粘贴到下方，不要写 https:// 前缀。
#   不填时代码会默认使用 devapi.qweather.com，仅便于本地快速试通；生产与长期运行请务必填专属 Host。
QWEATHER_API_HOST=

# ---------- Agent 时间提示（Convex / 本地均可）----------
# 写入 ReAct / 规划提示里的「当前本地时间」时区，默认 Asia/Shanghai
AGENT_TIMEZONE=Asia/Shanghai
# 成员4上下文工程：LLM prompt 预算估算，超出后裁剪 history 并写回 conversations.summary
AGENT_CONTEXT_TOKEN_BUDGET=6000

USE_LLM_REFLEXION=false

# ---------- LLM / 工具 HTTP 超时（Convex 云端 action 内生效，请在 Convex Dashboard 同步）----------
# LLM chat/completions 单次请求超时（毫秒），默认 120000
LLM_HTTP_TIMEOUT_MS=120000
# 429 限流：自动重试次数（不含首次请求），代码默认 8；指数退避基数默认 3500ms、单次等待上限默认 90000ms
LLM_429_MAX_RETRIES=8
LLM_429_RETRY_BASE_MS=3500
LLM_429_RETRY_CAP_MS=90000
# 当响应体含「访问量过大」等时，实际重试次数上限（避免越重试越 429）；默认 2
LLM_429_HEAVY_MAX_RETRIES=2
# 上述场景每次重试前的最小等待（毫秒），默认 12000
LLM_429_HEAVY_MIN_WAIT_MS=12000
# 两次 LLM 请求之间的最小间隔（毫秒），减轻 plan+revise+多步 ReAct 连续打满 QPS；默认 500
LLM_REQUEST_GAP_MS=500
# 天气、高德等工具 fetch 超时（毫秒），默认 45000
TOOL_HTTP_TIMEOUT_MS=45000
# 设为 1 则跳过「计划修订」第二次 LLM 调用（少一次请求，更易跑通；日志见 [agent] SKIP_PLAN_REVISION）
SKIP_PLAN_REVISION=0

# ---------- 前端等待 Convex action（仅浏览器，可选）----------
# 超过该毫秒数仍无返回则结束「运行中」并提示（默认 180000）；应大于 LLM+工具链路的合理上限
NEXT_PUBLIC_AGENT_CLIENT_TIMEOUT_MS=180000

# ---------- 迭代二评测平台联调（/api/eval/run；已在 proxy.ts 放行，不经 Clerk）----------
# 单次 Convex runAgentEval 时长上限与 Next 路由一致：app/api/eval/run/route.ts 中 maxDuration=1500（秒）。
# 评测平台侧请同步：AGENT_HTTP_READ_TIMEOUT_MS（默认 1560000 ms）、VITE_RUN_TASK_TIMEOUT_MS（默认 1800000 ms）。
# 【简化】EVAL_PUBLIC_EVAL=true：关闭 Bearer 与 EVAL_SERVER_SECRET 校验；须与 Convex Dashboard 同名变量同步，并 npx convex deploy。
#   仅建议本机/内网；公网切勿开启。
# 【默认】不配 EVAL_PUBLIC_EVAL 时：须 EVAL_SERVER_SECRET（长度≥8）三处相同——
#   Next、Convex（必须与浏览器里 NEXT_PUBLIC_CONVEX_URL 指向的部署一致）、Java 评测后端；
#   Java 会在 JSON 里带 evalSecret 并与 Bearer 一致；Convex 与 Next 会去掉 \\r、外层 \" \" 引号后再 NFKC 比对。
#   改 Convex 后务必 deploy。在 agent-app 目录核对：npx convex env get EVAL_SERVER_SECRET --prod
#   （须与浏览器 Network 里 js 请求的 NEXT_PUBLIC_CONVEX_URL 同属一个 Convex 项目/部署）
EVAL_PUBLIC_EVAL=
EVAL_SERVER_SECRET=
